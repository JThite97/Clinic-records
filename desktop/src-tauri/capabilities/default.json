{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: call server_info and open exported PDFs/documents in the system viewer.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/ClinicRecords/**" },
        { "path": "$HOME/.clinic-records/**" },
        { "path": "$DATA/ClinicRecords/**" },
        { "path": "$HOME/Library/Application Support/ClinicRecords/**" }
      ]
    }
  ]
}
